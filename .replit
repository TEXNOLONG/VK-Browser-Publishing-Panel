modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VK_APP_ID = "54795963"
VK_REDIRECT_URI = "https://10dc6e81-e6dd-420b-a656-0207367477e7-00-3p1qakqz0e9jq.sisko.replit.dev/api/auth/vk/callback"
