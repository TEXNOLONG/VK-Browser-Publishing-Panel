modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VK_APP_ID = "54795963"
VK_REDIRECT_URI = "https://8b252972-c299-40d7-b6c2-f49a49e30701-00-3lyvagotcr2t7.pike.replit.dev/api/auth/vk/callback"

[[ports]]
localPort = 8080
