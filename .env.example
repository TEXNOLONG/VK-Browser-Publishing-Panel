# VK ID application settings
# Copy this file to .env and replace the VK values.
VK_APP_ID=PASTE_VK_APP_ID
VK_APP_SECRET=PASTE_VK_APP_SECRET
VK_REDIRECT_URI=https://50503897-41b2-44a9-9085-071d95b27de9-00-166va3sj67vlc.sisko.replit.dev/api/auth/vk/callback

# Optional VK API settings
VK_OAUTH_SCOPE=groups,wall
VK_API_VERSION=5.199

# Replit provides SESSION_SECRET and DATABASE_URL automatically.
# Only set these locally if you run the API outside Replit.
SESSION_SECRET=PASTE_RANDOM_SESSION_SECRET
DATABASE_URL=PASTE_POSTGRES_CONNECTION_STRING